# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/xconnector?schema=public"

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Redis connection URL (required for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# ─── SECURITY ────────────────────────────────────────────────────────────────
# 32+ random bytes, used for HMAC-signed download URLs (never expose)
# Generate with: openssl rand -hex 32
CONNECTOR_SECRET="your-super-secret-256-bit-key-here"

# Shopify webhook secret (from Partners > App setup > Webhooks)
SHOPIFY_WEBHOOK_SECRET="your-shopify-webhook-secret"

# ─── SHOPIFY ─────────────────────────────────────────────────────────────────
# Multi-shop: one domain/token pair per shop, keyed by suffix (see lib/shops.ts).
# RO uses the bare (no-suffix) vars for backwards compatibility.
SHOPIFY_DOMAIN="your-store.myshopify.com"          # RO
SHOPIFY_ACCESS_TOKEN="shpat_..."                   # RO

SHOPIFY_DOMAIN_HU="your-store-hu.myshopify.com"
SHOPIFY_ACCESS_TOKEN_HU="shpat_..."

# GLATO: apps created via Shopify's Dev Dashboard (post Jan-2026) don't issue a
# permanent shpat_ token — use CLIENT_ID/CLIENT_SECRET instead (see lib/shopify/ccg-token.ts,
# which exchanges these for a 24h token on demand). Only set ACCESS_TOKEN_GLATO if this
# shop still has an old-style permanent custom-app token.
SHOPIFY_DOMAIN_GLATO="glato.myshopify.com"
SHOPIFY_CLIENT_ID_GLATO=""
SHOPIFY_CLIENT_SECRET_GLATO=""
# SHOPIFY_ACCESS_TOKEN_GLATO="shpat_..."

# ─── SMARTBILL ───────────────────────────────────────────────────────────────
SMARTBILL_EMAIL="your@email.com"
SMARTBILL_TOKEN="your-smartbill-api-token"
SMARTBILL_CIF="RO12345678"
SMARTBILL_SERIES="SERIE"           # invoice series, e.g. "GLA"
SMARTBILL_PAYMENT_SERIES=""        # receipt series (optional), e.g. "FSZ"
SMARTBILL_TAX_PERCENTAGE="19"      # 19 or 9 or 5
SMARTBILL_USE_STOCK="false"        # set true to decrement stock
SMARTBILL_WAREHOUSE=""             # warehouse name if useStock=true

# ─── GLS ─────────────────────────────────────────────────────────────────────
GLS_USERNAME="your-mygls-username"
GLS_PASSWORD="your-mygls-password"
GLS_CLIENT_NUMBER="553003585"
GLS_PICKUP_NAME="Firma SRL"
GLS_PICKUP_STREET="Str. Exemplu nr. 10"
GLS_PICKUP_CITY="Bucuresti"
GLS_PICKUP_ZIP="010101"
GLS_PICKUP_COUNTY="Ilfov"
GLS_PICKUP_PHONE="0712345678"

# ─── SAMEDAY ─────────────────────────────────────────────────────────────────
SAMEDAY_USERNAME="your-sameday-username"
SAMEDAY_PASSWORD="your-sameday-password"
SAMEDAY_PICKUP_POINT_ID=""         # auto-detected if empty
SAMEDAY_SERVICE_ID=""              # auto-detected if empty

# ─── S3 / OBJECT STORAGE ─────────────────────────────────────────────────────
# Leave empty to fall back to DB storage (base64 in Bytes column)
S3_BUCKET=""
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                     # custom endpoint for Cloudflare R2, MinIO, etc.
S3_PUBLIC_URL=""                   # CDN prefix (optional, internal only)

# ─── QUEUE BEHAVIOUR ─────────────────────────────────────────────────────────
# Set to "true" on serverless (Vercel) to process webhooks synchronously
# Set to "false" (default) for self-hosted / Docker with separate worker process
PROCESS_INLINE="false"

# Default courier for new orders: "gls" or "sameday"
DEFAULT_COURIER="gls"

# Token expiry for signed PDF download URLs (seconds, default 7 days)
SIGNED_URL_TTL="604800"

# ─── GEOAPIFY (optional address validation) ──────────────────────────────────
GEOAPIFY_KEY=""

# ─── GOOGLE (Gmail read + Drive storage for /documente) ──────────────────────
# One OAuth app covers both: reads attachments from Gmail (read-only, never
# modifies/deletes the original mailbox) and uploads them to Google Drive.
# Create in Google Cloud Console: enable Gmail API + Drive API, OAuth consent
# screen, then an OAuth Client ID (Web application) with GOOGLE_REDIRECT_URI
# below added to "Authorized redirect URIs".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-app.vercel.app/api/mail/google/callback"

# ─── MAIL ENCRYPTION ──────────────────────────────────────────────────────────
# 32 random bytes (hex), used to encrypt mailbox credentials at rest (Gmail
# refresh token, Yahoo app password) before they're stored in the DB.
# Generate with: openssl rand -hex 32
MAIL_ENCRYPTION_KEY=""

# ─── NEXT.JS PUBLIC URL ──────────────────────────────────────────────────────
# Used to build absolute URLs for tracking links, PDF endpoints
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
